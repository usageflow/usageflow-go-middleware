PORT=4003

# Required
USAGEFLOW_API_KEY=your-usageflow-api-key

# Only the provider(s) you actually call — withdraw/credit/close need neither
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: non-default UsageFlow socket (e.g. a local ledger). Default: wss://api.usageflow.io/ws
# USAGEFLOW_WS_URL=ws://localhost:9000/ws
