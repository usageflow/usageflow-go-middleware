{
  "openapi": "3.0.3",
  "info": {
    "title": "UsageFlow Vibe Example Apps (JS + Go)",
    "version": "1.0.0",
    "description": "Import into Postman together with the two environment files, then pick 'Vibe JS (4002)' or 'Vibe Go (4003)'. Routes tagged 'JS only' are not implemented in the Go app yet. A 403 means UsageFlow denied the call (quota/policy)."
  },
  "servers": [
    {
      "url": "{{base_url}}",
      "description": "Set base_url via the Postman environment (Vibe JS = :4002, Vibe Go = :4003)"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Chat"
    },
    {
      "name": "Embeddings"
    },
    {
      "name": "Ledger"
    },
    {
      "name": "JS only"
    }
  ],
