    "/api/close": {
      "post": {
        "tags": [
          "Ledger"
        ],
        "summary": "Close a capture (settle)",
        "description": "Settles a capture from withdraw-async/credit-async. `amount` defaults to the reserved amount. `identity` is only needed if the capture was made by another process. A capture closes once.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseBody"
              },
              "example": {
